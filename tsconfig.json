{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"strict": true,
		"noImplicitAny": false,
		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["src"]
}
